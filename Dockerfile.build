# Build Tom OS (Ubuntu live-build) on any Linux host, including Arch/Omarchy.
FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive

# Podman bridge DNS can intermittently fail on some Arch/Omarchy setups.
# The builder is also started with host networking; retries handle transient
# mirror or connection failures without silently continuing with stale indexes.
RUN apt-get -o Acquire::Retries=5 \
        -o Acquire::http::Timeout=30 \
        -o Acquire::https::Timeout=30 update \
 && apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
      live-build debootstrap squashfs-tools xorriso \
      grub-pc-bin grub-efi-amd64-bin grub-common mtools \
      rsync curl git ca-certificates dosfstools fdisk parted \
 && HACK="$(find /usr -type f -name chroot_hacks -print -quit)" \
 && test -n "$HACK" \
 && sed -i 's/-k all -t -u/-k all -u/g' "$HACK" \
 && ! grep -Fq -- '-k all -t -u' "$HACK" \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
