// ████ Tom OS — fastfetch ████
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/usr/share/tomos/fastfetch-logo.txt",
        "color": { "1": "38;2;255;45;150", "2": "38;2;199;76;255", "3": "38;2;0;240;255" },
        "padding": { "top": 1, "left": 2, "right": 4 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "38;2;255;45;150", "title": "38;2;0;240;255", "separator": "38;2;199;76;255" },
        "key": { "width": 12 }
    },
    "modules": [
        { "type": "title", "format": "{user-name-colored}@{host-name-colored}" },
        { "type": "custom", "format": "\u001b[38;2;199;76;255m──────────────────────────────────" },
        { "type": "os",       "key": " OS" },
        { "type": "kernel",   "key": " Kernel" },
        { "type": "uptime",   "key": "󰅐 Uptime" },
        { "type": "packages", "key": "󰏖 Packages" },
        { "type": "shell",    "key": " Shell" },
        { "type": "wm",       "key": " WM" },
        { "type": "command",  "key": "󰍂 Login", "text": "echo 'TDM — TomOS Display Manager'" },
        { "type": "command",  "key": "󰕮 Shell UI", "text": "b=$(cat ~/.config/tomos/bar 2>/dev/null || echo quickshell); [ \"$b\" = quickshell ] && echo 'Quickshell (neon bar)' || echo 'Waybar'" },
        { "type": "command",  "key": " Terminal", "text": "dpkg-query -W -f='kitty ${Version}' kitty 2>/dev/null | sed 's/-[^-]*$//'" },
        { "type": "font",     "key": " Font", "format": "JetBrainsMono Nerd Font" },
        { "type": "cpu",      "key": " CPU" },
        { "type": "gpu",      "key": "󰢮 GPU" },
        { "type": "memory",   "key": "󰍛 Memory" },
        { "type": "disk",     "key": "󰋊 Disk", "folders": "/" },
        { "type": "display",  "key": "󰍹 Display" },
        "break",
        { "type": "colors", "symbol": "circle" }
    ]
}
